# Backend selection:
# - auto: use direct API if WID_API_KEY_* is set, otherwise use the official R package.
# - r: force official R package mode.
# - api: force direct API mode.
WID_BACKEND=auto

# Optional: path to Rscript for official R package mode.
WID_RSCRIPT_BIN=Rscript

# Optional: direct API mode credentials. Most public users should leave these blank
# and install the official R package instead.
WID_API_KEY_BASE64=
WID_API_KEY_HEX=
